    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT held FROM ai_budget WHERE budget_key = $1::text) AS held,\n  (SELECT spent FROM ai_budget WHERE budget_key = $1::text) AS spent,\n  (SELECT COALESCE(json_agg(json_build_object('item_key', item_key, 'status', status, 'amount', amount, 'actual', actual)), '[]'::json) FROM ai_reservations WHERE budget_key = $1::text) AS reservations,\n  (SELECT COALESCE(json_agg(item_key), '[]'::json) FROM ai_budget_queue WHERE budget_key = $1::text) AS queued;",
        "options": {
          "queryReplacement": "={{ [$json.body.budget_key] }}"
        }
      },
      "id": "479c4828-23e0-4169-8300-c3d00da54d0c",
      "name": "Read ledger",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        420
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "sharedBudgetPg",
          "name": "Shared Budget Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst reservations = row.reservations ?? [];\nconst held = Number(row.held ?? 0);\nconst spent = Number(row.spent ?? 0);\nconst queued = row.queued ?? [];\nconst count = (status) => reservations.filter((row) => row.status === status).length;\nreturn [\n  {\n    json: {\n      held,\n      spent,\n      open: count('reserved'),\n      unknown: count('unknown'),\n      settled: count('settled'),\n      items: Object.fromEntries(reservations.map((row) => [row.item_key, row.status])),\n      queued,\n    },\n  },\n];"
      },
      "id": "703c1ec9-5241-4ac8-8932-5e4865d0df0d",
