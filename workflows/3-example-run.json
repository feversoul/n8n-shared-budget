      "id": "9358643e-2184-418e-8e3f-2cc5c9550f7e",
      "name": "Status of Postgres ledger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        420
      ],
      "webhookId": "63c4d62f-a5ca-48d3-8667-10c1cded8abc",
      "credentials": {
        "httpHeaderAuth": {
          "id": "sharedBudgetKey",
          "name": "Shared Budget Key"
        }
      }
