    {
      "parameters": {
        "jsCode": "const hook = $input.first().json;\nconst body = hook.body ?? {};\n// One model call per item. item_key must be the same when the run is retried.\nreturn (body.items ?? []).map((item) => ({\n  json: {\n    item_key: String(item.id),\n    prompt: `Answer with one word, the category of this message: ${item.text}`,\n    budget: body.budget,\n    cap_usd: body.cap_usd,\n    on_over_budget: body.on_over_budget,\n    ledger: String(hook.webhookUrl).endsWith('/postgres') ? 'postgres' : 'data-table',\n  },\n}));"
      },
      "id": "8f29522e-46cd-466d-833c-1159517b58d7",
      "name": "Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
