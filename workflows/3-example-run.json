    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      results: $input.all().map(({ json }) => ({\n        id: json.item_key,\n        ai: json.ai,\n        // The deterministic path for items that got no model call.\n        category: json.ai ? json.text : 'needs_review',\n        reason: json.reason,\n        queued: json.queued,\n        cost_micro_usd: json.cost_micro_usd,\n        budget_key: json.budget_key,\n      })),\n    },\n  },\n];"
      },
