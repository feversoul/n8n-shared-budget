        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "budget_queue"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "budget_key",
              "condition": "eq",
              "keyValue": "={{ $('Status of Data Table ledger').first().json.body.budget_key }}"
            }
          ]
        },
        "returnAll": true
      },
      "id": "fa62a4fd-431e-42c9-86f1-0d78b320504f",
      "name": "Read queue",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        800
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const reservations = $('Read rows').all().map((item) => item.json).filter((row) => row.id !== undefined);\nconst queued = $('Read queue').all().map((item) => item.json).filter((row) => row.id !== undefined).map((row) => row.item_key);\n// No total row: what is held is the sum of the rows.\nconst held = reservations.reduce((sum, row) => sum + Number(row.amount ?? 0), 0);\nconst spent = reservations.filter((row) => row.status === 'settled').reduce((sum, row) => sum + Number(row.amount ?? 0), 0);\nconst count = (status) => reservations.filter((row) => row.status === status).length;\nreturn [\n  {\n    json: {\n      held,\n      spent,\n      open: count('reserved'),\n      unknown: count('unknown'),\n      settled: count('settled'),\n      items: Object.fromEntries(reservations.map((row) => [row.item_key, row.status])),\n      queued,\n    },\n  },\n];"
      },
