# Any long random string. n8n encrypts stored credentials with it.
N8N_ENCRYPTION_KEY=
# The secret a caller puts in the X-Budget-Key header of the example webhooks.
WEBHOOK_KEY=
# Password of the PostgreSQL that holds the budget tables.
BUDGET_DB_PASSWORD=
# Key for the model API. The local stand-in accepts any value.
MODEL_API_KEY=local-stand-in
# Chat completions address. Default: the stand-in in this compose file.
# MODEL_URL=https://api.openai.com/v1/chat/completions
# Port of the n8n editor and the webhooks on this machine.
N8N_PORT=5678
